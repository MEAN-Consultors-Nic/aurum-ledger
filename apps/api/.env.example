PORT=3000
MONGO_URI=mongodb://localhost:27017/aurumledger
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_TTL_DAYS=7
ADMIN_EMAIL=admin@mean-consultors.com
ADMIN_PASSWORD=ChangeMe123!
CORS_ALLOWED=http://localhost:4200
FX_USD_TO_NIO=36
# 32-byte key (base64 or hex). Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# SMTP for outbound notifications (any provider: Gmail app password, cPanel, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AurumLedger <no-reply@yourdomain.com>"

# --- MCP server (agent access to the whole Helm API) ---
# Long-lived shared secret for headless MCP clients (ChatGPT connector, CI).
# Generate with: openssl rand -hex 32   — leave empty to disable.
MCP_SERVICE_TOKEN=
# Helm user the service token acts as (defaults to ADMIN_EMAIL).
MCP_SERVICE_USER_EMAIL=
# Optional allow/deny lists of operation ids, comma separated, globs allowed.
# Example: MCP_DENY=vault.*,users.*,reconcile.fix
MCP_ALLOW=
MCP_DENY=
# Base URL the MCP layer uses to reach this same API (defaults to loopback).
MCP_SELF_BASE_URL=
