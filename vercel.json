{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter web run build",
  "outputDirectory": "apps/web/dist/web/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
